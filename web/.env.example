# Copy to .env.local and fill from Firebase console -> Project settings -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Cloudflare replica worker URL (leave empty to read only from Firestore)
VITE_REPLICA_URL=https://school-replica.your-subdomain.workers.dev

# "true" to use local Firebase emulators
VITE_USE_EMULATORS=false
